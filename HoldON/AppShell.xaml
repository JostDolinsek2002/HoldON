<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HoldON.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HoldON.Views">

    <TabBar>
        <ShellContent Title="Domov"
                      ContentTemplate="{DataTemplate views:MainPage}" />
        <ShellContent Title="Vaje"
                      ContentTemplate="{DataTemplate views:ExercisesPage}" />
        <ShellContent Title="Statistika"
                      ContentTemplate="{DataTemplate views:StatisticsPage}" />
        <ShellContent Title="Profil"
                      ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>
