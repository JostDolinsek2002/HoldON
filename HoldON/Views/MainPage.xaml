<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HoldON.Views.MainPage"
             Title="Domov">

    <ScrollView>
        <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">

            <!-- Header / Hero -->
            <Frame Grid.Row="0"
                   CornerRadius="18"
                   Padding="18"
                   HasShadow="True">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                    <VerticalStackLayout Spacing="4">
                        <Label Text="HOLD ON"
                               FontSize="28"
                               FontAttributes="Bold"/>
                        <Label Text="Spremljaj treninge. Drži tempo. Napreduj."
                               FontSize="13"
                               Opacity="0.75"/>
                    </VerticalStackLayout>

                    <!-- “Badge” -->
                    <Frame Grid.Column="1"
                           Padding="10"
                           CornerRadius="14"
                           BackgroundColor="#EEE">
                        <Label Text="PROTOTIP"
                               FontAttributes="Bold"
                               FontSize="12"/>
                    </Frame>

                </Grid>
            </Frame>

            <!-- Quick actions -->
            <Label Grid.Row="1"
                   Text="Hitre akcije"
                   FontAttributes="Bold"
                   FontSize="16"/>

            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">

                <Frame CornerRadius="16" Padding="14" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🏋️ Vaje" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="Zbirka vaj z navodili" FontSize="12" Opacity="0.7"/>
                        <Button Text="Odpri"
                                Clicked="OnGoExercisesClicked"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" CornerRadius="16" Padding="14" HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="📈 Statistika" FontAttributes="Bold" FontSize="14"/>
                        <Label Text="PR-ji in trend napredka" FontSize="12" Opacity="0.7"/>
                        <Button Text="Poglej"
                                Clicked="OnGoStatsClicked"/>
                    </VerticalStackLayout>
                </Frame>

            </Grid>

            <!-- Card: Today -->
            <Label Grid.Row="3"
                   Text="Danes"
                   FontAttributes="Bold"
                   FontSize="16"/>

            <Frame Grid.Row="4" CornerRadius="16" Padding="14" HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="✅ Predlog za prototip" FontAttributes="Bold"/>
                    <Label Text="• Dodaj 1–3 vaje v zbirko" />
                    <Label Text="• Začni trening in zabeleži serije" />
                    <Label Text="• Preveri statistiko (volumen / PR)" />
                    <Button Text="Začni trening"
                            Clicked="OnGoStartTrainingClicked"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Footer hint -->
            <Label Grid.Row="5"
                   Text="Namig: spodaj imaš hitri TabBar za preklop med stranmi."
                   FontSize="12"
                   Opacity="0.6"/>
        </Grid>
    </ScrollView>

</ContentPage>
